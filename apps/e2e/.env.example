# Telefono (solo digitos, con indicativo) del canal de WhatsApp del agente
WA_AGENT_PHONE=
# Semilla opcional de Faker para repetir una corrida
E2E_SEED=
# URLs (por defecto las del compose local)
CRM_URL=http://127.0.0.1:3000
PAY_URL=http://127.0.0.1:3001
# Graba un video por pestana (true/false); cada pestana vive solo mientras se usa
E2E_VIDEO=false
# Pausa tras cada accion y tras cada respuesta del chat (segundos)
E2E_PAUSA_S=3
# Tope de mensajes enviados por corrida y minutos minimos entre corridas (anti-bloqueo)
E2E_MAX_MENSAJES=45
E2E_COOLDOWN_MIN=10
