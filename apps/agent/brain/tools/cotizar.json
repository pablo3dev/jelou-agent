      ],
      "configuration": {
        "title": "POST cotizar",
        "method": "POST",
        "url": "https://aerolinea-reservas.fn.jelou.ai/cotizar",
        "output": "resp",
        "headers": [
          {
            "id": "h1",
            "key": "Authorization",
            "value": "Bearer {{$secret.JELOU_FN_INVOKE_KEY}}",
            "enabled": true
          },
          {
            "id": "h2",
            "key": "Content-Type",
            "value": "application/json",
            "enabled": true
          }
        ],
        "body": {
          "type": "application/json",
          "content": "{{$context.cuerpo}}",
          "enabled": true
        },
        "settings": {
          "sslCertificate": true,
          "timeout": 30000
        }
      }
    },
    {
      "id": "n5CLn5zufSanyiR49WWQM",
      "type": "CODE",
      "title": "Respuesta con error",
      "position": [
        1360,
