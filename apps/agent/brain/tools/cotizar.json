      ],
      "configuration": {
        "title": "Respuesta con error",
        "content": "var r = $context.get(\"resp\") || {};\nvar st = Number(r.status) || 0;\n$output.set(\"respuesta\", JSON.stringify({ ok: st >= 200 && st < 300, status: st, data: r.data === undefined ? null : r.data }));",
        "memoryVersion": "v2"
      }
    },
